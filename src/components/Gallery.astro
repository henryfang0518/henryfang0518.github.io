---
interface Props {
	images: string[];
	title?: string;
}

const { images, title = "文章照片" } = Astro.props;
---

{
	images.length > 0 && (
		<div
			class="gallery mb-8 onload-animation"
			data-gallery
		>
			<div
				class="gallery-viewport"
				data-gallery-viewport
			>
				{images.map((imageUrl, index) => (
					<div
						class="gallery-slide"
						data-gallery-slide
					>
						<img
							src={imageUrl}
							alt={`${title}，第 ${index + 1} 張照片`}
							loading={index === 0 ? "eager" : "lazy"}
							draggable="false"
						/>
					</div>
				))}
			</div>

			{
				images.length > 1 && (
					<div class="gallery-controls">
						<button
							type="button"
							class="gallery-button"
							data-gallery-previous
							aria-label="上一張照片"
						>
							&#10094;
						</button>

						<div
							class="gallery-counter"
							aria-live="polite"
						>
							<span data-gallery-current>1</span>
							<span aria-hidden="true"> / </span>
							<span>{images.length}</span>
						</div>

						<button
							type="button"
							class="gallery-button"
							data-gallery-next
							aria-label="下一張照片"
						>
							&#10095;
						</button>
					</div>
				)
			}
		</div>
	)
}

<script>
function initializeGalleries() {
	const galleries =
		document.querySelectorAll("[data-gallery]");

	galleries.forEach((gallery) => {
		if (gallery.dataset.initialized === "true") {
			return;
		}

		const viewport =
			gallery.querySelector("[data-gallery-viewport]");

		const slides =
			gallery.querySelectorAll("[data-gallery-slide]");

		const previousButton =
			gallery.querySelector("[data-gallery-previous]");

		const nextButton =
			gallery.querySelector("[data-gallery-next]");

		const currentCounter =
			gallery.querySelector("[data-gallery-current]");

		if (!viewport || slides.length === 0) {
			return;
		}

		gallery.dataset.initialized = "true";

		let currentIndex = 0;
		let scrollTimer;

		const updateCounter = () => {
			if (currentCounter) {
				currentCounter.textContent =
					String(currentIndex + 1);
			}
		};

		const updateButtons = () => {
			if (previousButton) {
				previousButton.disabled =
					currentIndex === 0;
			}

			if (nextButton) {
				nextButton.disabled =
					currentIndex === slides.length - 1;
			}
		};

		const updateGallery = () => {
			const targetSlide = slides[currentIndex];

			viewport.scrollTo({
				left: targetSlide.offsetLeft,
				behavior: "smooth",
			});

			updateCounter();
			updateButtons();
		};

		previousButton?.addEventListener("click", () => {
			if (currentIndex > 0) {
				currentIndex -= 1;
				updateGallery();
			}
		});

		nextButton?.addEventListener("click", () => {
			if (currentIndex < slides.length - 1) {
				currentIndex += 1;
				updateGallery();
			}
		});

		viewport.addEventListener(
			"scroll",
			() => {
				clearTimeout(scrollTimer);

				scrollTimer = setTimeout(() => {
					const viewportLeft =
						viewport.scrollLeft;

					let closestIndex = 0;
					let closestDistance = Infinity;

					slides.forEach((slide, index) => {
						const distance = Math.abs(
							slide.offsetLeft - viewportLeft,
						);

						if (distance < closestDistance) {
							closestDistance = distance;
							closestIndex = index;
						}
					});

					currentIndex = closestIndex;

					updateCounter();
					updateButtons();
				}, 80);
			},
			{
				passive: true,
			},
		);

		updateCounter();
		updateButtons();
	});
}

	initializeGalleries();

	document.addEventListener(
		"astro:page-load",
		initializeGalleries,
	);
</script>

<style>
	.gallery {
		width: 100%;
		overflow: hidden;
		border-radius: 0.75rem;
		background-color: rgba(0, 0, 0, 0.04);
	}

	.gallery-viewport {
		display: flex;
		width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-behavior: smooth;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		touch-action: pan-x pan-y;
	}

	.gallery-viewport::-webkit-scrollbar {
		display: none;
	}

	.gallery-slide {
		display: flex;
		flex: 0 0 100%;
		width: 100%;
		align-items: center;
		justify-content: center;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		background-color: #000;
	}

	.gallery-slide img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 75vh;
		object-fit: contain;
		user-select: none;
		-webkit-user-drag: none;
	}

	.gallery-controls {
		display: grid;
		grid-template-columns: 2.75rem 1fr 2.75rem;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem;
	}

	.gallery-button {
		display: flex;
		width: 2.75rem;
		height: 2.75rem;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		border-radius: 9999px;
		background-color: rgba(0, 0, 0, 0.08);
		color: inherit;
		font-size: 1.25rem;
		cursor: pointer;
		transition:
			transform 150ms ease,
			background-color 150ms ease;
	}

	.gallery-button:hover {
		background-color: rgba(0, 0, 0, 0.14);
	}

	.gallery-button:active {
		transform: scale(0.92);
	}

.gallery-button:disabled {
	cursor: default;
	opacity: 0.3;
	pointer-events: none;
}

	.gallery-button:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.gallery-counter {
		text-align: center;
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		opacity: 0.7;
	}

	:global(.dark) .gallery {
		background-color: rgba(255, 255, 255, 0.06);
	}

	:global(.dark) .gallery-button {
		background-color: rgba(255, 255, 255, 0.12);
	}

	:global(.dark) .gallery-button:hover {
		background-color: rgba(255, 255, 255, 0.2);
	}
</style>
